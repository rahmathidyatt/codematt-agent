# Semua nilai hanya disimpan di environment server/hosting. Jangan commit nilai asli.
# Tanpa konfigurasi di bawah, aplikasi berjalan sebagai DEMO (tidak ada panggilan AI berbayar).

# --- Aplikasi & login (Supabase Auth, proyek khusus Codematt) ---
APP_ORIGIN=
CODEMATT_AUTH_ENABLED=
CODEMATT_DATABASE_ENABLED=
CODEMATT_SUPABASE_PROJECT_REF=
CODEMATT_SUPABASE_URL=
CODEMATT_SUPABASE_PUBLISHABLE_KEY=
# Kunci rahasia (sb_secret_...) untuk RPC kuota & langganan. Server saja.
CODEMATT_SUPABASE_SECRET_KEY=

# --- AI live ---
CODEMATT_ENABLE_LIVE_AI=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Opsional: ganti model tanpa ubah kode
CODEMATT_GEMINI_MODEL=
CODEMATT_OPENAI_MODEL=
CODEMATT_ANTHROPIC_MODEL=
CODEMATT_GEMINI_IMAGE_MODEL=
CODEMATT_OPENAI_IMAGE_MODEL=

# --- Endpoint lama /api/gateway & /api/ai/generate (token server-to-server) ---
CODEMATT_LIVE_AI_MAX_CALLS_PER_INSTANCE=
CODEMATT_LIVE_AI_TOKEN=
OPENAI_MODEL=

# --- Pembayaran Midtrans Snap ---
MIDTRANS_SERVER_KEY=
# "true" hanya setelah uji sandbox lulus
MIDTRANS_IS_PRODUCTION=
