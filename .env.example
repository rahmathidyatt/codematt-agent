# Local server settings; never commit real secrets.
APP_ORIGIN=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=

# Live provider billing remains OFF by default.
# Enabling this does not implement user authentication, tenancy, or durable quotas.
CODEMATT_ENABLE_LIVE_AI=false
# Create a random server-side token (at least 32 characters) before enabling live mode.
CODEMATT_LIVE_AI_TOKEN=

# Phase 2: configure only a DEDICATED Codematt Supabase project.
# No existing Brighton / Hybrid Office project should be reused.
CODEMATT_AUTH_ENABLED=false
CODEMATT_DATABASE_ENABLED=false

# Live provider models are server-to-server only.
# Do not expose CODEMATT_LIVE_AI_TOKEN to browser or NEXT_PUBLIC_ variables.
# Even when enabled, there are no durable user quotas or billing controls yet.
